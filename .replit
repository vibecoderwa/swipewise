run = "npm run dev"
modules = ["nodejs-20", "postgresql-16"]
hidden = [".config", "package-lock.json", "node_modules", "dist", "swipewise.db", "swipewise.db-journal", "swipewise.db-wal", "swipewise.db-shm"]

[nix]
channel = "stable-24_05"

[deployment]
run = ["bash", "-c", "cd backend && npm start"]
deploymentTarget = "vm"
build = ["bash", "-c", "cd backend && npm install && npm run build"]

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5173
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3000

[[ports]]
localPort = 8083
externalPort = 3002

[env]
NODE_ENV = "development"

[agent]
expertMode = true

[userenv]

[userenv.shared]
NODE_ENV = "development"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend API"

[[workflows.workflow]]
name = "Backend API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && PORT=8080 npm run dev"
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "console"
