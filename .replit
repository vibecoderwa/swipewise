run = "npm run dev"
modules = ["nodejs-20"]
hidden = [".config", "package-lock.json", "node_modules", "dist", "swipewise.db", "swipewise.db-journal", "swipewise.db-wal", "swipewise.db-shm"]

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "npm run build && npm start"]
deploymentTarget = "cloudrun"
build = ["sh", "-c", "npm install && npm run build"]

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5173
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3000

[[ports]]
localPort = 8083
externalPort = 3002

[env]
NODE_ENV = "development"

[agent]
expertMode = true

[userenv]

