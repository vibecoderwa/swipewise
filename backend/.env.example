# Database — Railway provides this automatically when you add a Postgres plugin
DATABASE_URL=postgresql://user:password@host:5432/swipewise

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-64-random-bytes
JWT_REFRESH_SECRET=change-me-to-64-random-bytes-different

# Plaid — use sandbox for development, production for App Store
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_sandbox_secret
PLAID_ENV=sandbox

# Twilio — optional; if not set, OTPs are logged to console (dev mode)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Server
PORT=3000
NODE_ENV=development
